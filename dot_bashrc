#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias grep='grep --color=auto'

alias ls='ls --color=auto'
alias ll='ls -ailhs'
alias llt='ls -ailhstr'

alias yayclean='sudo rm -rv /var/cache/pacman/pkg/download-* && yay -Sc'

PS1='[\u@\h \W]\$ '


HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoredups:erasedups


export PATH=$PATH:~/.local/bin

## GOLANG
export GOROOT=/usr/lib/go
export GOPATH=$HOME/.go
export PATH=$PATH:$GOROOT/bin:$GOPATH/bin

## BUN
export PATH="/home/fabien/.bun/bin:$PATH"

## OH-MY-POSH
eval "$(oh-my-posh init bash --config ~/.config/oh-my-posh/config.json)"

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"


alias mvnv='mvn clean verify -DskipTests'
alias mvnt='mvn test'
